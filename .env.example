# Copy to .env and replace the local placeholders. Never commit .env.
DATABASE_URL=postgresql://postgres:replace-this-password@127.0.0.1:5432/roblyne_dev
SESSION_SECRET=replace-with-a-random-secret

# Needed only for the first platform-admin setup. Use a random value of at least 32 bytes.
PLATFORM_ADMIN_BOOTSTRAP_SECRET=replace-with-a-random-one-time-setup-code

# Local Vite development sends /api requests to the API process on this origin.
LOCAL_API_ORIGIN=http://127.0.0.1:8080

# Optional: use S3-compatible storage to enable uploads during local development.
# Production requires all S3 values below.
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=false

# Optional: Redis enables shared rate limits, discovery caching, and BullMQ jobs.
# REDIS_URL=
# REDIS_REQUIRED=false
# QUEUE_REQUIRED=false

# Optional: real FlowPay credentials are required only when using FlowPay payments.
# Local development defaults to the payment simulator.
# EVENUM_PAYMENT_MODE=simulation
# FLOWPAY_ENVIRONMENT=sandbox
# FLOWPAY_SANDBOX_API_BASE_URL=
# FLOWPAY_SANDBOX_CLIENT_ID=
# FLOWPAY_SANDBOX_PUBLIC_KEY=
# FLOWPAY_SANDBOX_SECRET_KEY=
# FLOWPAY_SANDBOX_WEBHOOK_SECRET=
# FLOWPAY_SANDBOX_PROVIDER=FAPSHI
# FLOWPAY_TIMEOUT_MS=15000

# Optional. Use when the API and web page are on different origins, or when the
# web server needs an explicit API URL to render entity-specific link previews.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# API_BASE_URL=https://app.example.com/api
# LOG_LEVEL=info
