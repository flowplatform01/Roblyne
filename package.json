{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "preinstall": "node -e \"process.env.npm_config_user_agent?.startsWith('pnpm') || console.warn('Recommended: use pnpm')\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:render:web": "pnpm --filter @workspace/evenum run build",
    "build:render:api": "pnpm --filter @workspace/api-server run build",
    "build:render:worker": "pnpm --filter @workspace/api-server run build:worker",
    "migrate": "pnpm --filter @workspace/db run migrate",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --workspace-concurrency=1 --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:api": "pnpm --filter @workspace/api-server run test",
    "verify:stack": "pnpm --filter @workspace/scripts run verify:stack",
    "verify:render:artifacts": "node scripts/verify-render-artifacts.mjs"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.4",
    "typescript": "~5.9.3"
  }
}
